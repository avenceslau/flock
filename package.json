{
  "name": "flock",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/avenceslau/flock.git"
  },
  "type": "module",
  "scripts": {
    "check": "vp run fmt --check && vp check --no-fmt --deny-warnings",
    "fmt": "node tools/format.ts",
    "lint": "vp lint --deny-warnings",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "vp run -r test",
    "verify": "vp run check && vp run test"
  },
  "devDependencies": {
    "@dprint/typescript": "0.101.0",
    "@durability/lint": "0.4.0",
    "@oxlint/plugins": "1.94.0",
    "@types/node": "26.6.6",
    "dprint": "0.65.0",
    "vite-plus": "1.7.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@11.17.0"
}
